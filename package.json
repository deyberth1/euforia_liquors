{
  "name": "euforia-liquors",
  "version": "2.0.0",
  "private": true,
  "description": "Euforia Liquors · Sistema de mesas, pedidos y caja",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate-legacy": "tsx server/scripts/migrate-legacy.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.2",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
