# Base de datos (libSQL / Turso). En local puedes dejar la de archivo.
# Producción (Vercel): usa la URL libsql:// de tu base en Turso y su token.
DATABASE_URL=file:./data/euforia.db
DATABASE_AUTH_TOKEN=

# Secreto para firmar sesiones (JWT). Cambia esto en producción por una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto-en-produccion

# Usuario administrador inicial (solo se crea si la tabla de usuarios está vacía)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrador

# Puerto del API en desarrollo
PORT=3000
